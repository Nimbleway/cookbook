# Copy to .env and fill in.
NIMBLE_API_KEY="your-nimble-api-key"

# LLM provider is pluggable via init_chat_model. Set LLM_MODEL to "<provider>:<model>"
# and install that provider's LangChain package (langchain-openai is bundled).
#   openai:gpt-5.1  |  anthropic:claude-sonnet-5  |  google_genai:gemini-2.5-pro
LLM_MODEL="openai:gpt-5.1"
# Optional. Temperature is not sent unless set — gpt-5.x, the o-series and
# claude-sonnet-5 all reject the parameter.
# LLM_TEMPERATURE="0"

OPENAI_API_KEY="your-openai-api-key"

# Optional overrides
AGENT_RECURSION_LIMIT="40"
NIMBLE_CONTENT_CHAR_CAP="8000"

# Scan-pass description length (see README: every search runs at standard depth).
NIMBLE_SCAN_DESC_CHARS="220"
