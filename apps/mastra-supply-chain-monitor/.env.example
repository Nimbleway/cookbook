# Demo mode (false) replays saved research results and makes no Nimble runs.
# Set true to run the real monitor.
USE_LIVE=false

# Nimble: https://online.nimbleway.com/settings/api-keys
NIMBLE_API_KEY=
# From `npm run setup-agents`
NIMBLE_SWEEP_AGENT_ID=
NIMBLE_DEEP_DIVE_AGENT_ID=

# The model for the triage and investigator agents (Mastra model router).
ANTHROPIC_API_KEY=
# MODEL=anthropic/claude-sonnet-4-6

# Optional: a Slack incoming webhook for alerts. Unset = alerts print to the console.
SLACK_WEBHOOK_URL=

# Shared with the scheduler that calls /cron/sweep and /cron/collect.
# Generate one: openssl rand -base64 32
CRON_SECRET=

# Required on any deployed server: protects the agent API, Studio, and /digest.
# Leave empty for local development.
MONITOR_API_KEY=

# Deployed: injected by the Mastra platform when you attach a hosted Turso database.
# Local default: data/demo.db in demo mode, data/monitor.db in live mode
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
