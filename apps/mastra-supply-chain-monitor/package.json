{
  "name": "mastra-supply-chain-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "sweep": "tsx --env-file-if-exists=.env scripts/run.ts sweep",
    "collect": "tsx --env-file-if-exists=.env scripts/run.ts collect",
    "digest": "tsx --env-file-if-exists=.env scripts/digest.ts",
    "setup-agents": "tsx --env-file-if-exists=.env scripts/setup-agents.ts",
    "save-samples": "tsx --env-file-if-exists=.env scripts/save-samples.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "mastra build",
    "deploy": "mastra deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.76.0",
    "@mastra/libsql": "^1.26.0",
    "@mastra/memory": "^1.37.0",
    "@nimble-way/mastra": "^0.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mastra": "^1.34.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "description": "Supply chain event monitor: a Mastra app that runs Nimble Web Search Agents three times a day, triages new events per product, and alerts on the serious ones."
}
