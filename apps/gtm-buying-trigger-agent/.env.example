# Copy to .env and fill in.
# From online.nimbleway.com -> Account Settings -> API Keys (both patterns).
NIMBLE_API_KEY="your-nimble-api-key"

# From console.anthropic.com (Pattern A only).
ANTHROPIC_API_KEY="your-anthropic-api-key"

