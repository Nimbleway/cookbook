# Copy to .env and fill in.
# From online.nimbleway.com -> Account Settings -> API Keys (both patterns).
NIMBLE_API_KEY="your-nimble-api-key"

# From console.anthropic.com. Pattern A uses it for extraction and judging,
# Pattern B for the headcount trust gate.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Optional. The date the ICP is evaluated against (defaults to today).
# AS_OF_DATE="2026-10-07"
