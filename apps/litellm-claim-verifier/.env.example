# Nimble — https://nimbleway.com  (Settings → API keys)
NIMBLE_API_KEY=your_nimble_api_key

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# false = replay data/sample_run.json with no API calls (use this for recording)
USE_LIVE=true

# Replay pacing, in seconds per claim. 0 disables the animation.
REPLAY_DELAY=0.12

# ---------------------------------------------------------------------------
# Gateway mode (optional). Leave LITELLM_BASE_URL unset and the app talks
# straight to Anthropic and Nimble — no proxy needed, nothing else to run.
#
# Set it, and both model calls and the search call go through a LiteLLM proxy
# instead, so they appear in its dashboard at <base>/ui (Logs, Usage, Search
# Tools). Start the proxy with:  litellm --config config.yaml
# ---------------------------------------------------------------------------
# LITELLM_BASE_URL=http://127.0.0.1:4000
# LITELLM_MASTER_KEY=sk-your-proxy-master-key
# LITELLM_SEARCH_TOOL=nimble-search
