# ─── Nimble (does the actual research) ────────────────────────────────────────

# Get this from online.nimbleway.com → Account Settings → API Keys
NIMBLE_API_KEY=your_nimble_api_key_here

# Pre-created Web Search Agent ID from the Nimble console
NIMBLE_AGENT_ID=wsa_your_agent_id_here


# ─── Model provider (starts the run through the Vercel AI SDK) ────────────────
#
# Used once per report, to invoke the Nimble connector's startResearch tool.
# Status checks and result retrieval call the connector tools directly and
# spend no model tokens at all.
#
# Whichever model you choose must support tool calling: the start step is a
# forced tool call.

# Which provider to use: openrouter | openai | gateway
# Leave unset and the first provider below with a key set wins.
RESEARCH_PROVIDER=openrouter

# Model id for that provider. Leave unset to take the provider's default.
#   openrouter → google/gemma-4-31b-it:free   (free tier)
#   gateway    → openai/gpt-5-nano
#   openai     → gpt-5-nano
RESEARCH_MODEL=google/gemma-4-31b-it:free

# Set the key for the provider you picked above. Only one is needed.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here


# ─── Optional ─────────────────────────────────────────────────────────────────

# Path to your drug list (JSON or CSV), defaults to a bundled example
# DRUG_LIST_PATH=./data/drugs.json
