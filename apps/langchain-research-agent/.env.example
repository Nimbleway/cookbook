# Nimble API key — https://online.nimbleway.com/account-settings/api-keys
NIMBLE_API_KEY=

# Model provider for the routing agent
ANTHROPIC_API_KEY=

# Optional: set to replay cached results instead of calling the live API
USE_LIVE=false

# Optional: LangSmith tracing. Unset = no tracing, app works normally.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langchain-gap-filler
