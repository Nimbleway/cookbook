# Nimble API key (online.nimbleway.com -> Account Settings -> API Keys)
NIMBLE_API_KEY=

# Web Search Agent IDs. `npm run agents:find` prints these lines for agents named gallery-hf-*.
# An agent left blank is skipped on refresh.
NIMBLE_AGENT_DEEP_DIVE=
NIMBLE_AGENT_CHANNEL_CHECK=
NIMBLE_AGENT_FILING_CHANGES=
NIMBLE_AGENT_FORENSIC=
NIMBLE_AGENT_MANAGEMENT=
NIMBLE_AGENT_CATALYSTS=
NIMBLE_AGENT_SUPPLY_CHAIN=
NIMBLE_AGENT_COMPETITORS=
NIMBLE_AGENT_GOV_CONTRACTS=

# Slack incoming webhook for meaningful-change alerts (optional)
SLACK_WEBHOOK_URL=

# Public URL of the app, linked from Slack alerts (optional)
APP_URL=

# Supabase project that stores companies, agent results, runs, refreshes and changes (run supabase/schema.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Runs started at once (Nimble accounts default to 30 concurrent agent runs)
MAX_CONCURRENT_RUNS=25

# Optional: require this key to start a refresh (the app asks for it once)
REFRESH_KEY=

# Optional: Vercel sends this as a Bearer token on the daily cron call
CRON_SECRET=
