# Nimble API key for Search (find pricing pages) and Extract (read them).
# Get one at https://nimbleway.com
NIMBLE_API_KEY=your_nimble_api_key

# Slack through Vercel Connect: the connector UID and the channel that gets alerts.
SLACK_CONNECTOR=slack/pricing-brief
SLACK_CHANNEL_ID=C0123456789

# Postgres connection string. Set automatically when you add Neon (or another
# Postgres) to the Vercel project.
DATABASE_URL=postgres://user:password@host/db

# Vercel Blob read/write token. Only used by `npm run demo:price` to change the
# Acme Mail demo page's price. Set automatically when you add a Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
