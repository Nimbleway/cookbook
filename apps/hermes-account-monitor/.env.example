# Nimble API key — https://online.nimbleway.com/account-settings/api-keys
# Without it the plugin's nimble_agent* tools stay hidden.
NIMBLE_API_KEY=

# Model provider for the Hermes agent loop (any Hermes-supported provider works)
ANTHROPIC_API_KEY=

# Replay the cached digest instead of calling the live API
USE_LIVE=false

# Optional — Slack delivery. Both tokens are required (Socket Mode).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...          # scope: connections:write
